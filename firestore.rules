rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(getUserId())).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function getCollegeId() {
      return getUserData().collegeId;
    }

    function ownsDocument(doc) {
      return doc.data().userId == getUserId();
    }

    function ownsDocumentField(field) {
      return field == getUserId();
    }

    function isValidCollegeId(collegeId) {
      return collegeId != null && collegeId != '';
    }

    function isValidContentType(type) {
      return type in ['lost', 'found', 'market', 'skill'];
    }

    // ─── Verification / membership helpers ─────────────────────────────────
    // Campus access is granted ONLY by an active membership document, which
    // can be created or activated exclusively by the trusted backend
    // (Firebase Admin SDK bypasses these rules, so backend code enforces the
    // checks itself). Clients can never write these documents.

    function membershipDoc() {
      return get(/databases/$(database)/documents/memberships/$(getUserId()));
    }

    /** A verified, currently active membership exists for this account. */
    function hasActiveMembership() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/memberships/$(getUserId()))
        && membershipDoc().data.status == 'active';
    }

    /** College the active membership belongs to (used for scoping content). */
    function membershipCollegeId() {
      return membershipDoc().data.collegeId;
    }

    /**
     * True when the user holds an active membership in the college that owns
     * this content. Every college-restricted collection uses this.
     */
    function isActiveMemberOf(collegeId) {
      return hasActiveMembership() && membershipCollegeId() == collegeId;
    }

    /** Self-scoped access for the current user's own attempts. */
    function isOwn(doc) {
      return isSignedIn() && doc.data.userId == getUserId();
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isSignedIn() && (getUserId() == userId || isAdmin());

      // Users can create their profile on signup.
      // Backend-owned fields (accountStatus, verificationStatus, role, …) and
      // protected membership fields may never be supplied by the client.
      allow create: if isSignedIn() && getUserId() == userId
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'email', 'collegeId', 'collegeName', 'collegeShortName',
             'colDomain', 'collegeEmail', 'collegeEmailVerified', 'avatarUrl', 'rating',
             'reviewCount', 'hasSeenOnboarding', 'createdAt', 'skillsOffered',
             'skillsRequested'
           ])
        && request.resource.data.uid == getUserId()
        && (!('role' in request.resource.data));

      // Users can update their own profile (limited fields).
      allow update: if isSignedIn() && getUserId() == userId && (
          // Ordinary self-service profile fields.
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'name', 'avatarUrl', 'bio', 'major', 'gradYear', 'socials', 'quietMode',
            'dataSaver', 'blockedUsers', 'hasSeenOnboarding', 'collegeEmail',
            'collegeEmailVerified', 'online', 'lastSeen', 'updatedAt'
          ])
          || (
            // College selection is only permitted before any verification
            // attempt exists and while no membership is active. After that,
            // the college (and therefore the verification) can only change
            // through the trusted backend.
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly([
                'collegeId', 'collegeName', 'collegeShortName', 'colDomain',
                'collegeEmail', 'collegeEmailVerified'
              ])
            && !exists(/databases/$(database)/documents/memberships/$(getUserId()))
            && (
                 !('verificationStatus' in resource.data)
                 || resource.data.verificationStatus in ['not_started', 'cancelled']
               )
          )
        )
        // Immutable identity + backend-owned fields.
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && !('accountStatus' in request.resource.data.diff(resource.data).affectedKeys())
        && !('verificationStatus' in request.resource.data.diff(resource.data).affectedKeys())
        && !('verifiedCollegeId' in request.resource.data.diff(resource.data).affectedKeys())
        && !('membershipStatus' in request.resource.data.diff(resource.data).affectedKeys())
        && !('createdAt' in request.resource.data.diff(resource.data).affectedKeys())
        // Note: a personal-email verification flag is NOT college affiliation
        // and grants nothing. It is kept for informational purposes only.
        && (
             !('collegeEmailVerified' in request.resource.data)
             || request.resource.data.collegeEmailVerified != true
             || (
               request.auth.token.email_verified == true
               && request.resource.data.collegeEmail == request.auth.token.email
             )
           );

      // Admins can do anything
      allow read, write: if isAdmin();

      // Prevent deletion
      allow delete: if false;
    }

    // ============================================================
    // COLLEGES COLLECTION (Read-only for users, Admin write)
    // ============================================================
    match /colleges/{collegeId} {
      allow read: if isSignedIn() && isValidCollegeId(collegeId);

      // The verification configuration (verificationEnabled,
      // verificationProviderId, verificationProgramId) is admin-controlled.
      // The client may never write a provider program id.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
             'name', 'shortName', 'domain', 'domains', 'location', 'verified',
             'memberCount', 'verificationEnabled', 'verificationMethod'
           ]);
      allow update: if isAdmin()
        && request.resource.data.verificationEnabled is bool
        && request.resource.data.verificationMethod in ['provider_redirect', 'manual_review'];
      allow delete: if isAdmin();
    }

    // ============================================================
    // VERIFICATION ATTEMPTS (backend-only writes)
    // ============================================================
    match /verifications/{attemptId} {
      // A student may read the safe status projection of their OWN attempt.
      allow read: if isOwn(resource) || isAdmin();

      // Clients cannot create, mutate or forge verification state. All writes
      // happen through the trusted backend (Admin SDK), which ignores rules.
      allow create, update, delete: if false;

      // Provider references and raw provider responses never leave the server.
      match /private/{privateId} {
        allow read, write: if false;
      }

      // Per-attempt transition history.
      match /audit/{auditId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ============================================================
    // MEMBERSHIPS (backend-only writes)
    // ============================================================
    match /memberships/{userId} {
      // A student may read their own membership state (used for gating UI).
      // Admins may read all memberships for support/review.
      allow read: if isSignedIn() && (getUserId() == userId || isAdmin());

      // Only the trusted backend can create, activate, suspend or revoke a
      // membership. No client-side grant path exists.
      allow create, update, delete: if false;
    }

    // ============================================================
    // VERIFICATION AUDIT TRAIL (backend-only writes, admin reads)
    // ============================================================
    match /verification_audit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // RATE LIMITS (backend-only)
    // ============================================================
    match /rate_limits/{key} {
      allow read, write: if false;
    }

    // ============================================================
    // LOST & FOUND COLLECTION
    // ============================================================
    match /lost_found/{itemId} {
      // College-restricted: only an active member of that college.
      allow read: if isSignedIn() && isActiveMemberOf(resource.data.collegeId)
        && resource.data.status != 'resolved';

      // Admins can read all
      allow read: if isAdmin();

      // Users can create items in their college
      allow create: if isSignedIn() && hasActiveMembership()
        && request.resource.data.userId == getUserId()
        && request.resource.data.collegeId == membershipCollegeId()
        && isValidContentType(request.resource.data.type)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time;

      // Owner or admin can update (status, resolution)
      allow update: if isSignedIn() && hasActiveMembership() && (ownsDocument(resource) || isAdmin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.collegeId == resource.data.collegeId
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'resolvedAt', 'resolvedBy', 'description', 'location', 'imageUrl']);

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================
    // MARKETPLACE COLLECTION
    // ============================================================
    match /marketplace/{itemId} {
      // College-restricted: only an active member of that college.
      allow read: if isSignedIn() && isActiveMemberOf(resource.data.collegeId)
        && resource.data.status != 'sold';

      // Admins can read all
      allow read: if isAdmin();

      // Users can create listings in their college
      allow create: if isSignedIn() && hasActiveMembership()
        && request.resource.data.userId == getUserId()
        && request.resource.data.collegeId == membershipCollegeId()
        && request.resource.data.status == 'active'
        && request.resource.data.price >= 0
        && request.resource.data.createdAt == request.time;

      // Owner or admin can update (status, price, description)
      allow update: if isSignedIn() && hasActiveMembership() && (ownsDocument(resource) || isAdmin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.collegeId == resource.data.collegeId
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'soldAt', 'soldTo', 'price', 'description', 'condition', 'category', 'imageUrl']);

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================
    // SKILLS COLLECTION
    // ============================================================
    match /skills/{skillId} {
      // College-restricted: only an active member of that college.
      allow read: if isSignedIn() && isActiveMemberOf(resource.data.collegeId);

      // Admins can read all
      allow read: if isAdmin();

      // Users can create skill listings in their college
      allow create: if isSignedIn() && hasActiveMembership()
        && request.resource.data.userId == getUserId()
        && request.resource.data.collegeId == membershipCollegeId()
        && request.resource.data.maxParticipants >= 1
        && request.resource.data.createdAt == request.time;

      // Owner or admin can update
      allow update: if isSignedIn() && hasActiveMembership() && (ownsDocument(resource) || isAdmin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.collegeId == resource.data.collegeId
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'description', 'schedule', 'location', 'maxParticipants', 'imageUrl']);

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================
    // SKILL RESERVATIONS SUB-COLLECTION
    // ============================================================
    match /skills/{skillId}/reservations/{reservationId} {
      // Skill owner and reserved user can read
      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/skills/$(skillId)).data.userId == getUserId()
        || resource.data.userId == getUserId()
        || isAdmin()
      );

      // Users can reserve a spot
      allow create: if isSignedIn() && hasActiveMembership()
        && request.resource.data.userId == getUserId()
        && request.resource.data.skillId == skillId
        && request.resource.data.status == 'confirmed'
        && request.resource.data.createdAt == request.time
        // Check skill has capacity
        && get(/databases/$(database)/documents/skills/$(skillId)).data.currentParticipants
          < get(/databases/$(database)/documents/skills/$(skillId)).data.maxParticipants;

      // User can cancel their reservation, owner can manage
      allow update: if isSignedIn() && (
        resource.data.userId == getUserId()
        || get(/databases/$(database)/documents/skills/$(skillId)).data.userId == getUserId()
        || isAdmin()
      )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================
    // CHATS COLLECTION
    // ============================================================
    match /chats/{chatId} {
      // Participants can read their chats
      allow read: if isSignedIn() && getUserId() in resource.data.participants;

      // Admins can read all
      allow read: if isAdmin();

      // Participants can create chats (validated by Cloud Function in practice)
      allow create: if isSignedIn() && hasActiveMembership()
        && getUserId() in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.createdAt == request.time;

      // Participants can update lastMessage, unreadCount
      allow update: if isSignedIn() && getUserId() in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'unreadCount', 'participantNames']);

      // No delete (archive instead)
      allow delete: if false;
    }

    // ============================================================
    // MESSAGES SUB-COLLECTION
    // ============================================================
    match /chats/{chatId}/messages/{messageId} {
      // Participants can read messages
      allow read: if isSignedIn() && getUserId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

      // Admins can read all
      allow read: if isAdmin();

      // Participants can send messages
      allow create: if isSignedIn() && hasActiveMembership()
        && getUserId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        && request.resource.data.senderId == getUserId()
        && request.resource.data.chatId == chatId
        && request.resource.data.createdAt == request.time
        && request.resource.data.text.size() <= 5000; // Max message length

      // No update/delete for messages (immutable)
      allow update, delete: if false;
    }

    // ============================================================
    // REVIEWS COLLECTION
    // ============================================================
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if isSignedIn();

      // Only the reviewer can create their review
      allow create: if isSignedIn() && hasActiveMembership()
        && request.resource.data.reviewerId == getUserId()
        && request.resource.data.revieweeId != getUserId() // Can't review yourself
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;

      // Only reviewer can update their review (within 24 hours)
      allow update: if isSignedIn() && ownsDocument(resource)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['rating', 'comment'])
        && request.time < resource.data.createdAt + duration.value(86400000); // 24 hours in ms

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================
    // NOTIFICATIONS COLLECTION
    // ============================================================
    match /notifications/{notificationId} {
      // User can read their own notifications
      allow read: if isSignedIn() && resource.data.userId == getUserId();

      // Admins can read all
      allow read: if isAdmin();

      // System creates notifications (via Cloud Functions)
      allow create: if false; // Only Cloud Functions (admin SDK) can create

      // User can mark as read
      allow update: if isSignedIn() && resource.data.userId == getUserId()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read']);

      // User can delete their notifications
      allow delete: if isSignedIn() && resource.data.userId == getUserId();
    }

    // ============================================================
    // REPORTS COLLECTION (Content moderation)
    // ============================================================
    match /reports/{reportId} {
      // Only admins can read reports
      allow read: if isAdmin();

      // Users can create reports
      allow create: if isSignedIn()
        && request.resource.data.reporterId == getUserId()
        && request.resource.data.reportedUserId != getUserId()
        && request.resource.data.createdAt == request.time;

      // Only admins can update (status, resolution)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================
    // SETTINGS / CONFIG (App-wide config, admin only)
    // ============================================================
    match /config/{configId} {
      allow read: if isSignedIn(); // Public config readable by all users
      allow write: if isAdmin();
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
