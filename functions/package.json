{
  "name": "campusforge-functions",
  "version": "1.0.0",
  "description": "CampusForge trusted backend: verification lifecycle, membership, provider integration",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "serve": "firebase emulators:start --only functions,firestore --project campusloop-54d64",
    "start": "node lib/server/index.js",
    "deploy": "firebase deploy --only functions",
    "admin": "node scripts/admin-verify.mjs",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-campusforge \"vitest run\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^13.4.2",
    "firebase-functions": "^6.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
